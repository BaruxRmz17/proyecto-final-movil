{
  "expo": {
    "name": "campus-mind",
    "slug": "campus-mind",
    "version": "1.0.0",
    "scheme": "campus-mind",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/campus-mind-logo.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#7957DC"
              },
              "textColor": {
                "light": "#292342"
              },
              "textColorPrimary": {
                "light": "#292342"
              },
              "textColorSecondary": {
                "light": "#817995"
              },
              "windowBackground": {
                "light": "#FFFFFF"
              }
            },
            "timePicker": {
              "background": {
                "light": "#FFFFFF"
              },
              "headerBackground": {
                "light": "#7957DC"
              },
              "numbersBackgroundColor": {
                "light": "#FFFFFF"
              },
              "numbersSelectorColor": {
                "light": "#EDE6FF"
              },
              "numbersTextColor": {
                "light": "#292342"
              }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baruxx.campusmind"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.baruxx.campusmind"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c860499b-ed07-428e-a53d-711dfa8ef85e"
      }
    }
  }
}
