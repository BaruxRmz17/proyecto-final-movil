{
  "expo": {
    "name": "campus-mind",
    "slug": "campus-mind",
    "version": "1.0.0",
    "scheme": "campus-mind",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#7957DC"
              },
              "textColor": {
                "light": "#292342"
              },
              "textColorPrimary": {
                "light": "#292342"
              },
              "textColorSecondary": {
                "light": "#817995"
              },
              "windowBackground": {
                "light": "#FFFFFF"
              }
            },
            "timePicker": {
              "background": {
                "light": "#FFFFFF"
              },
              "headerBackground": {
                "light": "#7957DC"
              },
              "numbersBackgroundColor": {
                "light": "#FFFFFF"
              },
              "numbersSelectorColor": {
                "light": "#EDE6FF"
              },
              "numbersTextColor": {
                "light": "#292342"
              }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baruxx.campusmind"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.baruxx.campusmind"
    }
  }
}
